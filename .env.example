# Copy to .env and fill in. Never commit .env.

# YouTube Data API v3 key
YOUTUBE_API_KEY=

# 32-byte HMAC key encoded as exactly 64 hexadecimal characters.
# Generate with: py -3.12 -c "import secrets; print(secrets.token_hex(32))"
# Keep private and stable within its registered identity scope. Never commit it.
SENTIRA_HMAC_KEY=
